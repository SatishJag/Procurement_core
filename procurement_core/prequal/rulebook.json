  "rule_sets": [
    {
      "id": "pq-contractor",
      "type": "prequalification",
      "party": "contractor",
      "label": "Contractor prequalification",
      "status": "draft",
      "author": "rules-import",
      "categories": { "Company Profile": 20, "Financial Strength": 30, "Technical Capability": 30, "Project Management Maturity": 10, "Compliance & Governance": 10 },
      "criteria": [
        { "id": "PQ-CP-01", "category": "Company Profile", "name": "Years in operation", "weight": 5, "kind": "numeric", "unit": "years", "role": "vendor_manager",
          "bands": [[5, "15 years or more", 15, null], [4, "10 to 14 years", 10, 15], [3, "5 to 9 years", 5, 10], [2, "2 to 4 years", 2, 5], [1, "Under 2 years", 0, 2]] },
        { "id": "PQ-CP-02", "category": "Company Profile", "name": "Landmark projects in this trade, last 10 years", "weight": 10, "kind": "numeric", "unit": "projects", "role": "technical", "no_evidence_rating": 1,
          "bands": [[5, "5 or more", 5, null], [4, "3 to 4", 3, 5], [3, "2", 2, 3], [2, "1", 1, 2], [1, "None evidenced", 0, 1]] },
        { "id": "PQ-CP-03", "category": "Company Profile", "name": "Organisation and key personnel", "weight": 5, "kind": "rubric", "role": "vendor_manager",
          "bands": [[5, "Full organogram; named key staff with 15+ years in trade-specific roles"], [4, "Organogram and CVs for all key roles, 10+ years"], [3, "Organogram with most key roles named"], [2, "Partial organogram; key roles vacant or generic"], [1, "No organisation evidence"]] },
        { "id": "PQ-CP-04", "category": "Company Profile", "name": "Client testimonials", "weight": 0, "kind": "rubric", "role": "vendor_manager",
          "bands": [[5, "Three or more signed client references"], [4, "Two signed references"], [3, "One signed reference"], [2, "Unsigned references only"], [1, "None"]] },
        { "id": "PQ-FS-01", "category": "Financial Strength", "name": "Average annual turnover, last 3 audited years", "weight": 10, "kind": "numeric", "unit": "AED M", "role": "commercial",
          "bands": [[5, "AED 1,000M or more", 1000, null], [4, "AED 500M to 999M", 500, 1000], [3, "AED 250M to 499M", 250, 500], [2, "AED 100M to 249M", 100, 250], [1, "Under AED 100M", 0, 100]] },
        { "id": "PQ-FS-02", "category": "Financial Strength", "name": "Working capital ratio (current assets / current liabilities)", "weight": 10, "kind": "numeric", "unit": "ratio", "role": "commercial",
          "bands": [[5, "1.50 or higher", 1.5, null], [4, "1.25 to 1.49", 1.25, 1.5], [3, "1.10 to 1.24", 1.1, 1.25], [2, "1.00 to 1.09", 1.0, 1.1], [1, "Below 1.00", null, 1.0]] },
        { "id": "PQ-FS-03", "category": "Financial Strength", "name": "Average net profit margin, last 3 years", "weight": 5, "kind": "numeric", "unit": "%", "role": "commercial",
          "bands": [[5, "8% or more", 8, null], [4, "5% to 7.9%", 5, 8], [3, "2% to 4.9%", 2, 5], [2, "0% to 1.9%", 0, 2], [1, "Loss-making", null, 0]] },
        { "id": "PQ-FS-04", "category": "Financial Strength", "name": "Banking and bonding capacity", "weight": 5, "kind": "rubric", "role": "commercial",
          "bands": [[5, "Bank letter confirms bonding above 3x the largest package value"], [4, "2x to 3x"], [3, "1x to 2x"], [2, "Below the package value"], [1, "No bank letter"]] },
        { "id": "PQ-TC-01", "category": "Technical Capability", "name": "Relevant trade experience", "weight": 10, "kind": "rubric", "role": "technical",
          "bands": [[5, "Three or more completed projects of similar scale and typology in this trade within 5 years"], [4, "Two such projects"], [3, "One similar project, others smaller"], [2, "Only smaller projects or a different typology"], [1, "No relevant experience"]] },
        { "id": "PQ-TC-02", "category": "Technical Capability", "name": "Directly employed workforce", "weight": 8, "kind": "numeric", "unit": "% of workforce", "role": "technical",
          "bands": [[5, "70% or more directly employed", 70, null], [4, "50% to 69%", 50, 70], [3, "30% to 49%", 30, 50], [2, "10% to 29%", 10, 30], [1, "Under 10%", 0, 10]] },
        { "id": "PQ-TC-03", "category": "Technical Capability", "name": "Owned plant and equipment", "weight": 6, "kind": "rubric", "role": "technical",
          "bands": [[5, "Owns all critical plant for the trade, with maintenance records"], [4, "Owns most critical plant; balance on framework lease"], [3, "Mix of owned and spot-hired plant"], [2, "Mostly spot-hired"], [1, "No plant evidence"]] },
        { "id": "PQ-TC-04", "category": "Technical Capability", "name": "Current project and site assessment", "weight": 6, "kind": "rubric", "role": "site_assessor",
          "bands": [[5, "Site visit: well resourced, HSE and QA visible, programme on track"], [4, "Minor observations only"], [3, "Several observations; corrective plan agreed"], [2, "Major observations: under-resourced or behind programme"], [1, "Red flags, or site visit refused"]] },
        { "id": "PQ-PM-01", "category": "Project Management Maturity", "name": "Planning and project controls", "weight": 4, "kind": "rubric", "role": "technical",
          "bands": [[5, "Resource-loaded CPM programmes, earned value and monthly reporting"], [4, "CPM programmes and monthly reporting"], [3, "Baseline programme with basic progress tracking"], [2, "Bar charts only"], [1, "No planning evidence"]] },
        { "id": "PQ-PM-02", "category": "Project Management Maturity", "name": "Quality management system", "weight": 3, "kind": "rubric", "role": "qa_qc", "no_evidence_rating": 1,
          "bands": [[5, "ISO 9001 certified and audited; project QA/QC plans; low NCR history"], [4, "ISO 9001 certified with project QA plans"], [3, "Documented QMS, not certified"], [2, "Partial procedures"], [1, "No QMS, or not submitted"]] },
        { "id": "PQ-PM-03", "category": "Project Management Maturity", "name": "Digital and BIM maturity", "weight": 3, "kind": "rubric", "role": "technical",
          "bands": [[5, "ISO 19650 aligned; BIM coordination and a CDE on live projects"], [4, "BIM coordination on most projects"], [3, "BIM on selected projects"], [2, "2D only, some digital tools"], [1, "No digital capability"]] },
        { "id": "PQ-CG-01", "category": "Compliance & Governance", "name": "HSE performance (LTIFR per 200,000 hours)", "weight": 5, "kind": "numeric", "unit": "LTIFR", "role": "hse",
          "bands": [[5, "Below 0.10", 0, 0.1], [4, "0.10 to 0.29", 0.1, 0.3], [3, "0.30 to 0.59", 0.3, 0.6], [2, "0.60 to 0.99", 0.6, 1.0], [1, "1.00 or higher", 1.0, null]] },
        { "id": "PQ-CG-02", "category": "Compliance & Governance", "name": "Litigation and arbitration exposure", "weight": 3, "kind": "rubric", "role": "legal",
          "bands": [[5, "No disputes in 5 years"], [4, "Resolved minor disputes under 1% of turnover"], [3, "Open disputes under 3% of turnover"], [2, "Open disputes 3% to 10% of turnover"], [1, "Disputes above 10% of turnover, or undisclosed"]] },
        { "id": "PQ-CG-03", "category": "Compliance & Governance", "name": "Licences, insurance and certifications", "weight": 2, "kind": "rubric", "role": "vendor_manager", "no_evidence_rating": 1,
          "bands": [[5, "All valid; ISO 45001 and 14001 held; insurance above requirement"], [4, "All valid; ISO 45001 held"], [3, "All mandatory items valid"], [2, "One item expiring within 90 days"], [1, "Expired or not submitted"]] }
      ]
    },
    {
      "id": "pq-consultant",
      "type": "prequalification",
      "party": "consultant",
      "label": "Consultant prequalification",
      "status": "draft",
      "author": "rules-import",
      "requires_mandatory_flag": true,
      "categories": { "Company Profile": 10, "Relevant Experience": 20, "Organisational & Technical Resources": 20, "Design Quality & Management": 20, "Digital & BIM": 15, "Past Performance": 5, "Financial Stability": 5, "Legal & Regulatory": 5 },
      "criteria": [
        { "id": "PQ-CN-01", "category": "Company Profile", "name": "Company profile and licensing", "weight": 10, "kind": "rubric", "mandatory": false, "role": "vendor_manager",
          "bands": [[5, "Established 15+ years, licensed locally, stable ownership"], [4, "10+ years, licensed locally"], [3, "5+ years, licence in progress"], [2, "Under 5 years"], [1, "No profile evidence"]] },
        { "id": "PQ-CN-02", "category": "Relevant Experience", "name": "Comparable design commissions", "weight": 20, "kind": "rubric", "mandatory": true, "role": "design_manager",
          "bands": [[5, "Three or more comparable commissions completed in 5 years"], [4, "Two"], [3, "One comparable, others smaller"], [2, "Only smaller or different typology"], [1, "None"]] },
        { "id": "PQ-CN-03", "category": "Organisational & Technical Resources", "name": "Team and discipline coverage", "weight": 20, "kind": "rubric", "mandatory": true, "role": "design_manager",
          "bands": [[5, "All disciplines in-house with senior leads"], [4, "Core disciplines in-house, specialists under framework"], [3, "Core disciplines in-house"], [2, "Heavy reliance on subconsultants"], [1, "No resource evidence"]] },
        { "id": "PQ-CN-04", "category": "Design Quality & Management", "name": "Design management and quality controls", "weight": 20, "kind": "rubric", "mandatory": true, "role": "design_manager",
          "bands": [[5, "Certified QMS, design reviews and checking at every stage, low RFI rate"], [4, "Certified QMS with stage reviews"], [3, "Documented review process"], [2, "Ad hoc reviews"], [1, "No evidence"]] },
        { "id": "PQ-CN-05", "category": "Digital & BIM", "name": "BIM capability", "weight": 15, "kind": "rubric", "mandatory": false, "role": "design_manager",
          "bands": [[5, "ISO 19650 certified; federated models and CDE on all projects"], [4, "BIM Level 2 on most projects"], [3, "BIM on selected projects"], [2, "2D with some 3D"], [1, "No BIM"]] },
        { "id": "PQ-CN-06", "category": "Past Performance", "name": "Past performance with the client", "weight": 5, "kind": "rubric", "mandatory": false, "role": "design_manager", "no_evidence_rating": 3,
          "bands": [[5, "Rated excellent on recent commissions"], [4, "Rated good"], [3, "No prior commissions with the client"], [2, "Rated below expectations once"], [1, "Rated poor, or terminated"]] },
        { "id": "PQ-CN-07", "category": "Financial Stability", "name": "Financial stability", "weight": 5, "kind": "rubric", "mandatory": false, "role": "commercial",
          "bands": [[5, "Audited accounts show growth and positive cash flow for 3 years"], [4, "Stable and profitable"], [3, "Profitable in 2 of 3 years"], [2, "Losses in 2 of 3 years"], [1, "No audited accounts"]] },
        { "id": "PQ-CN-08", "category": "Legal & Regulatory", "name": "Professional indemnity and legal standing", "weight": 5, "kind": "rubric", "mandatory": true, "role": "legal",
          "bands": [[5, "PI cover above requirement, no claims in 5 years"], [4, "PI cover meets requirement, minor claims resolved"], [3, "PI cover meets requirement, open minor claims"], [2, "PI cover below requirement"], [1, "No PI cover or material litigation"]] }
      ]
    },
    {
      "id": "te-contractor",
      "type": "technical_evaluation",
      "party": "contractor",
      "label": "Contractor technical evaluation",
      "status": "draft",
      "author": "rules-import",
      "categories": {},
      "criteria": [
        { "id": "TE-01", "name": "Credentials on comparable projects", "weight": 10, "kind": "rubric", "role": "technical",
          "bands": [[5, "Three or more comparable projects, references verified"], [4, "Two comparable projects"], [3, "One comparable project"], [2, "Only smaller or different scope"], [1, "No credentials submitted"]] },
        { "id": "TE-02", "name": "Proposed project team", "weight": 12, "kind": "rubric", "role": "technical",
          "bands": [[5, "Named team, all key roles exceed CV requirements, committed full time"], [4, "Named team meets all requirements"], [3, "Most roles meet requirements"], [2, "Key roles unnamed or below requirement"], [1, "No team proposed"]] },
        { "id": "TE-03", "name": "Resource deployment and histogram", "weight": 10, "kind": "rubric", "role": "technical",
          "bands": [[5, "Resource-loaded histogram matches programme; majority directly employed"], [4, "Histogram matches programme"], [3, "Histogram with minor gaps"], [2, "Generic histogram"], [1, "None submitted"]] },
        { "id": "TE-04", "name": "Method statement and approach", "weight": 12, "kind": "rubric", "role": "technical",
          "bands": [[5, "Project-specific methodology covering sequencing, logistics and interfaces"], [4, "Project-specific with minor gaps"], [3, "Partly generic"], [2, "Generic"], [1, "None submitted"]] },
        { "id": "TE-05", "name": "Technical compliance with specification", "weight": 14, "kind": "rubric", "role": "technical",
          "bands": [[5, "Fully compliant, no deviations"], [4, "Minor clarifications only"], [3, "Minor deviations with acceptable alternatives"], [2, "Material deviations"], [1, "Non-compliant"]] },
        { "id": "TE-06", "name": "Programme and schedule", "weight": 10, "kind": "rubric", "role": "planning",
          "bands": [[5, "Meets all milestones with float; critical path logic sound"], [4, "Meets all milestones"], [3, "Meets key milestones"], [2, "Misses some milestones"], [1, "No programme"]] },
        { "id": "TE-07", "name": "QA/QC and commissioning", "weight": 10, "kind": "rubric", "role": "qa_qc",
          "bands": [[5, "Project quality plan, ITPs and commissioning plan to the required level"], [4, "Quality plan and ITPs"], [3, "Quality plan only"], [2, "Generic QA statement"], [1, "None"]] },
        { "id": "TE-08", "name": "HSE plan", "weight": 8, "kind": "rubric", "role": "hse",
          "bands": [[5, "Project-specific HSE plan with risk assessments and strong record"], [4, "Project-specific HSE plan"], [3, "Generic HSE plan"], [2, "Incomplete HSE plan"], [1, "None"]] },
        { "id": "TE-09", "name": "Risk management", "weight": 6, "kind": "rubric", "role": "technical",
          "bands": [[5, "Project risk register with owners and mitigations"], [4, "Risk register with mitigations"], [3, "Key risks listed"], [2, "Generic risks"], [1, "None"]] },
        { "id": "TE-10", "name": "Value engineering proposals", "weight": 4, "kind": "rubric", "role": "technical",
          "bands": [[5, "Quantified VE options that keep performance"], [4, "VE options, partly quantified"], [3, "Qualitative VE options"], [2, "Minor suggestions"], [1, "None"]] },
        { "id": "TE-11", "name": "Supply chain and long-lead procurement", "weight": 4, "kind": "rubric", "role": "technical",
          "bands": [[5, "Named suppliers with lead times and slots secured"], [4, "Named suppliers with lead times"], [3, "Named suppliers"], [2, "Supplier list only"], [1, "None"]] }
      ],
      "trade_weights": {
