        "FAC": { "TE-01": 12, "TE-02": 10, "TE-03": 8, "TE-04": 12, "TE-05": 16, "TE-06": 10, "TE-07": 10, "TE-08": 8, "TE-09": 4, "TE-10": 4, "TE-11": 6 },
        "SHR": { "TE-01": 10, "TE-02": 10, "TE-03": 12, "TE-04": 14, "TE-05": 12, "TE-06": 10, "TE-07": 8, "TE-08": 14, "TE-09": 10, "TE-10": 0, "TE-11": 0 }
      }
    },
