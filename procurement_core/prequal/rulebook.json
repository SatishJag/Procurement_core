          "bands": [[5, "Lowest compliant bid (L1)", null, 0], [4, "Up to 5% above L1", 0, 5], [3, "5% to 10% above L1", 5, 10], [2, "10% to 15% above L1", 10, 15], [1, "More than 15% above L1", 15, null]] },
