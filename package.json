{
  "name": "@satishjag/procurement-core",
  "version": "0.1.0",
  "description": "Source-to-Contract capability core: intake, planning, suppliers, sourcing, evaluation, awards, contracts, reporting",
  "type": "module",
  "exports": {
    ".": "./modules/index.js",
    "./core": "./core/kernel.js",
    "./types": "./core/types.js"
  },
  "files": [
    "core",
    "modules"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-esm.mjs",
    "test": "node --import ./test/ts-resolve.mjs --test test/*.test.ts",
    "typecheck": "tsc",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SatishJag/procurement-core.git"
  },
  "keywords": [
    "procurement",
    "source-to-contract",
    "sourcing",
    "evaluation",
    "awards",
    "capital-projects"
  ],
  "author": "Satish Jag",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.131.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
